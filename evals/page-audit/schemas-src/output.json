{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "page-audit output",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_url", "h2_count", "h2_headings", "published_date", "days_to_2026"],
  "properties": {
    "source_url": {"type": "string", "minLength": 1},
    "h2_count": {"type": "integer", "minimum": 0},
    "h2_headings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "published_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "days_to_2026": {"type": ["integer", "null"]}
  }
}
