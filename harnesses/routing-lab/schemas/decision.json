{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "routing-lab decision",
  "type": "object",
  "required": [
    "severity",
    "owner",
    "action"
  ],
  "additionalProperties": false,
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    }
  }
}
