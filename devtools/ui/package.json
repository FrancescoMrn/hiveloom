{
  "name": "hiveloom-workbench",
  "version": "0.1.0",
  "type": "module",
  "description": "The Hiveloom workbench: a local inspector for building, running, and improving agent harnesses.",
  "keywords": ["hiveloom", "agents", "llm", "harness", "workbench", "inspector"],
  "license": "Apache-2.0",
  "homepage": "https://github.com/FrancescoMrn/hiveloom/blob/main/docs/workbench.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancescoMrn/hiveloom.git",
    "directory": "devtools/ui"
  },
  "bugs": "https://github.com/FrancescoMrn/hiveloom/issues",
  "bin": {
    "hiveloom-workbench": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "web/",
    "server.py",
    "copilot/",
    "interface-template.html",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "geist": "^1.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
