{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "example-summarizer output",
  "type": "object",
  "required": [
    "title",
    "summary",
    "key_points"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "key_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
